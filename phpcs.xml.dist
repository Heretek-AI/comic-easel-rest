<?xml version="1.0"?>
<ruleset name="Comic Easel REST">
	<description>
		Escaping and security sniffs for Comic Easel REST.

		Scoped deliberately narrow. The companion plugin is new code under
		development, and a full WordPress-Extra run produces findings on every
		helper. Start with the sniffs that catch the bug classes WP REST plugins
		have actually had -- unescaped output, unprepared SQL, missing nonce and
		capability checks -- and widen later if needed.
	</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="5.6"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress.Security"/>
	<rule ref="WordPress.DB.PreparedSQL"/>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
	<rule ref="WordPress.WP.EnqueuedResources"/>
</ruleset>