{
	"name": "heretek-ai/comic-easel-rest",
	"description": "REST API endpoints for Comic Easel — exposes the comic CPT, chapters/characters/locations taxonomies, and CEO options over WP REST for automation tools (e.g. n8n) using Application Passwords.",
	"type": "wordpress-plugin",
	"license": "GPL-3.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"autoload": {
		"classmap": [
			"includes/"
		]
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^3.0",
		"squizlabs/php_codesniffer": "^3.10",
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phan/phan": "^6.0",
		"vimeo/psalm": "^6",
		"php-stubs/wordpress-stubs": "^7.1",
		"php-stubs/wordpress-tests-stubs": "^7.1"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"test": "phpunit",
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"lint:php": "find . -name '*.php' -not -path './vendor/*' -not -path './.git/*' -print0 | xargs -0 -n1 php -l",
		"analyse": [
			"@analyse:phan",
			"@analyse:psalm"
		],
		"analyse:phan": "phan --no-progress-bar",
		"analyse:psalm": "psalm --no-progress"
	}
}
